  "authors": ["fate"],
  "license": "MIT",
  "icon": "assets/combatdata/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.combatdata.CombatDataClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "combatdata.mixins.json"
  ]
}